{
  "manifest_version": 3,
  "name": "GemInWeb",
  "version": "0.1.0",
  "description": "Lets Google AI Studio and Gemini use your local files and shell (DevSpace-style bridge).",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "nativeMessaging",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1:7679/*",
    "http://localhost:7679/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content/selectors.js",
        "content/protocol.js",
        "content/sites.js",
        "content/rpc.js",
        "content/panel.js",
        "content/agent.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
